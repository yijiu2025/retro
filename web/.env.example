# ============================================================
# RetroChimera 网页版 —— 环境配置模板
# ------------------------------------------------------------
# 用法：复制本文件为 `.env` 后按需修改。
#   🔴 `.env` 里有 API Key，**不要提交到 git**（已在 .gitignore 里排除）。
#
# 改完**立即生效、无需重启**（Python 侧按文件 mtime 热重载）。
# 解析顺序：真实环境变量 > web/.env > <仓库根>/.env（后者可选）
#          ⇒ 临时覆盖用 `set RETRO_LLM_MODEL=xxx` 即可，不必改文件。
# ============================================================

# ---------- 模型目录（换机部署时改这一处） ----------
# 默认取 <仓库根>/models/。模型**不随 git 分发**（9GB），
# 换机时把模型目录拷过去，然后二选一：
#   ① 放在仓库根的 models/ 下（默认约定，什么都不用配）
#   ② 放到别处 → 设 RETRO_MODELS_DIR 指过去
# 也可以只挪某一个：RETRO_MODEL_PISTACHIO / RETRO_MODEL_USPTO50K
#
# RETRO_MODELS_DIR=D:\models\retrochimera

# ---------- 规则应用子进程数 ----------
# 🔴 必须限制：每个子进程加载完整规则库约 4.4 GB。按 CPU 核数开满会打满页面文件
#    并报 "WinError 1455 页面文件太小"。默认 4，内存充裕可调大。
RETRO_RULE_WORKERS=4

# ---------- 跨域（换机部署时前端不在同源就要配） ----------
# 🔴 不配的话浏览器会拦掉全部请求，控制台只说 "Failed to fetch"，看不出是 CORS。
# dev 走 vite proxy（同源）不需要；生产填前端 origin，逗号分隔。
# RETRO_CORS_ORIGINS=https://retro.example.com,http://localhost:5177

# ---------- 大模型 API（用于「工艺分析」） ----------
# 「投料顺序 / 当量 / 条件 / 副产物 / LCMS / NMR」由它生成。
# 任何 OpenAI 兼容的服务都行；**留空 = 功能自动降级**（前端显示「未配置」，不报错）。
#
# ⚠️ 填错端点/模型不会崩溃，但每次分析都会报错 —— 先自检：
#      curl "http://127.0.0.1:8000/api/llm/status?probe=1"   # 真发一次最小请求
#      curl "http://127.0.0.1:8000/api/llm/models"           # 列出可用模型
#
# 常见填法：
#   DeepSeek 官网  https://api.deepseek.com/v1                    model=deepseek-chat
#   通义千问       https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
#   智谱 GLM      https://open.bigmodel.cn/api/paas/v4            model=glm-4-plus
#   Kimi          https://api.moonshot.cn/v1                      model=moonshot-v1-8k
#   本地 Ollama    http://127.0.0.1:11434/v1                      model=qwen2.5:14b（key 随便填）
#   本地 vLLM      http://127.0.0.1:8001/v1                       model=<你部署的名字>
RETRO_LLM_BASE_URL=
RETRO_LLM_API_KEY=
RETRO_LLM_MODEL=

# 🔴 单次输出 token 上限。**必须显式给**：推理模型的思考 token 也算在输出额度里，
#    给太小会出现"正文一个字都没输出就被截断"（finish_reason=length），JSON 抽不出来。
RETRO_LLM_MAX_TOKENS=16384

# 单次分析超时（秒）。推理模型 + 长 prompt 建议留足（实测单步思考可达 55 秒）
RETRO_LLM_TIMEOUT=300

# 是否请求严格 JSON 输出（response_format=json_object）。不支持的服务改 0
RETRO_LLM_JSON_MODE=1

# 采样温度（化学场景要稳，建议 0.2~0.4）
RETRO_LLM_TEMPERATURE=0.3

# ---------- 服务端口 ----------
RETRO_PORT=8000
